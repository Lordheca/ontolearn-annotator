GITHUB_CLIENT_ID=CLIENT_ID
GITHUB_CLIENT_SECRET=CLIENT_SECRET
NEXTAUTH_URL="http://localhost:3000"

# MariaDB from docker-compose.dev.yml, published on host port 3307.
# The Prisma provider is mysql and the migrations are MySQL dialect, so a postgresql://
# URL here fails at the migrate step. Use db:3306 instead of localhost:3307 only when the
# app itself runs inside the compose network.
DATABASE_URL="mysql://app:ChangeMe@localhost:3307/app"

AUTH_SECRET="CHANGE_ME"

# maildev from docker-compose.dev.yml; its web UI is on http://localhost:1080
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=noreply@example.com

# inheritance_service from the ABAC_NII stack listens on 5004.
ABAC_SERVER_URL="http://localhost:5004"
# Must be byte-identical to SECRET_KEY in ABAC_NII/inheritance_service/.env
ABAC_SECRET="CHANGE_ME_ABAC_SECRET"
ABAC_CACHE_TTL=3600
ABAC_CACHE_SIZE_LIMIT=10000